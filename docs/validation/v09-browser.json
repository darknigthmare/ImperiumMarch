  "flows": [
    {
      "id": "migration",
      "result": "Exact v7-to-v8 migration, preserving all seven reports, resources and prior fields; adds only the empty departure object and version8. Native export matches expected JSON."
    },
    {
      "id": "MI01",
      "actions": [
        "Create disposable test dossier after preserving original export",
        "Open briefing; Tab focus visible; Enter deploys",
        "Walk right2.2s and fire three cannon rounds",
        "Escape pause; return to command deck; export; reload; export; resume",
        "Inspect imported completed MI01 consequences in hangar, crew and archives"
      ],
      "scope": "Native movement/pause/reload/reprise verified. Completed MI01 report used for UI review is an authentic prepared earlier dossier, not a new full native playthrough."
    },
    {
      "id": "portable-save",
      "actions": [
        "Import prepared valid MI01 dossier with explicit in-product confirmation",
        "Export from Chrome",
        "Reject invalid JSON through native file chooser",
        "Export preserved dossier",
        "Reimport the actual Chrome export with confirmation and export again"
      ],
      "result": "Byte equality and absence of extra rewards are checked in v09-browser-export-audit.json."
    },
    {
      "id": "MI02",
      "actions": [
        "Unlock MI02 from imported MI01 report",
        "Open briefing, deploy and walk",
        "Import the explicitly prepared chase checkpoint",
        "Resume and walk1.6s during pursuit; screenshot; pause",
        "Export; reload; export; resume",
        "Interact with E and remain anchored4.5s; export stopped train",
        "Import authentic prepared two-report dossier; inspect both reports and both replay briefings"
      ],
      "scope": "Native chase, reload and braking verified from prepared public-simulation checkpoint. This is not a full MI02 native campaign completion."
    },
    {
      "id": "controls",
      "actions": [
        "Attempt to assign E to Avancer: conflict message shown",
        "Escape cancels capture",
        "Assign K, reload, confirm K persists",
        "Restore default bindings",
        "Tab and Shift+Tab display visible focus; Escape closes briefing and restores opener focus",
        "Native Chrome zoom125 and150; Tab scrolls deployment button into view; restore100"
      ]
    },
    {
      "id": "MI08",
      "preparedInput": "docs/validation/v09-browser-native-gate-input.json",
      "actions": [
        "Import prepared descendant of actual historical seven-report dossier at partial passage gate",
        "Resume; anchor; save partial gate position; reload and compare exact checkpoint",
        "E plus anchor opens passage",
        "Wait for real departures:34 departed,0 arrived",
        "E plus anchor closes passage after both boats exit",
        "Walk toward registry; observe27 arrivals then34",
        "Interact and transmit only after every person reaches terminal destination",
        "Finish extraction and inspect result",
        "Export completed dossier and reload/export again",
        "Expand Aval roster and inspect36 individual rows including4patients,2local technicians and Mara Eren"
      ],
      "result": {
        "census": 36,
        "departed": 34,
        "refuge": 34,
        "local": 2,
        "lost": 0,
        "patientsRefuge": 4,
        "boatsDeparted": 2,
        "boatsArrived": 2,
        "boatsLost": 0,
        "locks": "both closed",
        "reportTransmitted": true
      },
      "scope": "Preparatory MI08 play before the partial gate was done by the public simulation driver. Gate-to-result was exercised natively with no further checkpoint imports; the first extraction included the unresolved focus/input observation in QA19. A later address-bar retry restored the actual native transmitted export, not the Node completed reference."
    }
  ],
